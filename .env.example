# 复制为 .env 后填写。默认真人参与，其余 AI 自动跟随以下接口配置。
# 留空优先使用 DeepSeek 配置池，按 AI 座位循环分配。也可填写 deepseek、qwen、mock 等配置 ID。
LLM_DEFAULT_PROVIDER=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 同一 DeepSeek 地址和模型可填写多组 Key，留空的条目跳过。
# 默认真人玩家 1，玩家 2 用主 Key，玩家 3 用 API2，依次循环。
DEEPSEEK_API2=
DEEPSEEK_API3=
DEEPSEEK_API4=
DEEPSEEK_API5=
DEEPSEEK_API6=
DEEPSEEK_API7=

# 其他 OpenAI 兼容服务按同一前缀的三个变量自动发现，模型名请从服务商文档填写。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=

# 可继续添加 OTHER_API_KEY、OTHER_BASE_URL、OTHER_MODEL，网页自动出现 other。
# 指定某个座位的默认接口，留空时使用全局默认。真人座位忽略接口配置。
AGENT_2_PROVIDER=
AGENT_3_PROVIDER=

# 所有接口共用参数，接口前缀也可覆盖，例如 QWEN_TEMPERATURE=0.8。
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.9

# DeepSeek 官方当前模型默认采用非思考模式，使温度生效并减少等待。
# 如需深度推理可设 enabled，并适当提高 MAX_TOKENS 与 TIMEOUT。
DEEPSEEK_THINKING=auto

# 可选豆包文字转语音，与大模型发言 API 分开计费。默认使用本机温柔男/女声。
# 新版控制台填写 API Key，旧版填写 App ID + Access Token，二者任选一种鉴权。
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
